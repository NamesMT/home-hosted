{
  "name": "home-hosted",
  "type": "module",
  "version": "0.12.0",
  "packageManager": "pnpm@12.5.1",
  "description": "Self-hosted control panel that keeps your home-server processes alive: supervision, restarts, port conflicts, logs — and a UI you can replace.",
  "author": "NamesMT <dangquoctrung123@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/NamesMT/home-hosted#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NamesMT/home-hosted.git"
  },
  "bugs": {
    "url": "https://github.com/NamesMT/home-hosted/issues"
  },
  "keywords": [
    "self-hosted",
    "homelab",
    "home-server",
    "control-panel",
    "admin-panel",
    "process-manager",
    "process-supervisor",
    "supervisor",
    "daemon",
    "autostart",
    "systemd",
    "launchd",
    "windows-service",
    "port-conflict",
    "health-check",
    "logs",
    "telegram",
    "backups",
    "hono",
    "vue",
    "typescript"
  ],
  "imports": {
    "#src/*": "./src/*",
    "#src/providers/ddns": "./src/providers/ddns/index.ts",
    "#src/providers/proxy": "./src/providers/proxy/index.ts",
    "#src/services/supervisor": "./src/services/supervisor.ts"
  },
  "exports": {
    ".": "./dist/cli.js",
    "./client": {
      "types": "./dist/types/client.d.ts",
      "import": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/cli.js",
  "bin": {
    "home-hosted": "bin/home-hosted.mjs",
    "hh": "bin/home-hosted.mjs"
  },
  "files": [
    "LICENSE",
    "README.md",
    "bin",
    "dist",
    "docs/API.md",
    "docs/BACKUPS.md",
    "docs/CLI.md",
    "docs/DDNS.md",
    "docs/NOTIFICATIONS.md",
    "docs/REVERSE_PROXY.md",
    "docs/SECURITY.md",
    "docs/SERVERS.md",
    "docs/UI_CREATION.md",
    "docs/branding/logo.svg",
    "docs/branding/social-preview.png",
    "docs/demo/blank-host-restore.sh",
    "uis/stock/dist"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "cli": "tsx src/cli.ts --home .dev-state",
    "up": "tsx src/cli.ts --home .dev-state up",
    "down": "tsx src/cli.ts --home .dev-state down",
    "status": "tsx src/cli.ts --home .dev-state status",
    "restart": "tsx src/cli.ts --home .dev-state restart",
    "start": "tsx src/cli.ts --home .dev-state up --foreground",
    "dev": "node scripts/dev.mjs",
    "build": "pnpm run build:ui && pnpm run build:server && pnpm run build:client",
    "build:server": "vite build --config vite.server.config.ts",
    "build:client": "vite build --config vite.client.config.ts && node scripts/build-types.mjs",
    "lint": "eslint .",
    "test:docs": "node scripts/check-doc-links.mjs",
    "test": "vitest",
    "test:types": "tsc --noEmit && node scripts/typecheck-uis.mjs",
    "quickcheck": "node scripts/quickcheck.mjs",
    "check": "pnpm run quickcheck && vitest run --coverage",
    "check:fast": "pnpm run quickcheck && vitest run --sinceLastRun",
    "prepare": "simple-git-hooks && pnpm run build:locales",
    "build:locales": "node scripts/build-locales.mjs",
    "prepack": "pnpm run build",
    "build:ui": "node scripts/build-uis.mjs stock",
    "build:uis": "node scripts/build-uis.mjs --zip",
    "brand": "node scripts/build-brand.mjs",
    "media": "node scripts/capture-media.mjs"
  },
  "dependencies": {
    "@namesmt/utils": "^0.5.21",
    "@zip.js/zip.js": "^2.24.0",
    "arktype": "^2.2.8",
    "citty": "^0.2.2",
    "consola": "^3.4.2",
    "hono": "^4.13.13",
    "hono-openapi": "^1.3.5",
    "srvx": "^1.0.6",
    "std-env": "^4.3.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@i18n-micro/vue": "^1.4.10",
    "@lucide/vue": "^1.59.0",
    "@standard-schema/spec": "^1.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/test-utils": "^2.5.1",
    "clsx": "^2.1.1",
    "eslint": "^10.13.0",
    "gifenc": "^1.0.3",
    "happy-dom": "^20.14.6",
    "lint-staged": "^17.6.0",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "reka-ui": "^2.11.0",
    "simple-git-hooks": "^2.14.0",
    "splitpanes": "^4.1.2",
    "spreadsheet-i18n": "^0.3.12",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.1.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vue-tsc": "^3.3.13"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged && node scripts/stamp-uis.mjs"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
