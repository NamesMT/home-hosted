{
  "name": "home-hosted",
  "type": "module",
  "version": "0.6.2",
  "packageManager": "pnpm@12.5.1",
  "description": "A self-hosted control panel that keeps your home server processes alive - with a UI you can replace.",
  "author": "NamesMT <dangquoctrung123@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/NamesMT/home-hosted#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NamesMT/home-hosted.git"
  },
  "bugs": {
    "url": "https://github.com/NamesMT/home-hosted/issues"
  },
  "keywords": [
    "home-server",
    "process-manager",
    "supervisor",
    "self-hosted",
    "control-panel",
    "daemon",
    "hono",
    "ui"
  ],
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": {
    ".": "./dist/cli.js",
    "./package.json": "./package.json"
  },
  "main": "./dist/cli.js",
  "bin": {
    "home-hosted": "bin/home-hosted.mjs",
    "hh": "bin/home-hosted.mjs"
  },
  "files": [
    "AGENTS.md",
    "LICENSE",
    "README.md",
    "bin",
    "dist",
    "docs/NOTIFICATIONS.md",
    "docs/SERVERS.md",
    "docs/UI_CREATION.md",
    "uis/stock/dist"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "up": "tsx src/cli.ts up",
    "down": "tsx src/cli.ts down",
    "status": "tsx src/cli.ts status",
    "restart": "tsx src/cli.ts restart",
    "start": "tsx src/cli.ts up --foreground",
    "dev": "node scripts/dev.mjs",
    "build": "pnpm run build:ui && pnpm run build:server",
    "build:server": "vite build --config vite.server.config.ts",
    "set-password": "tsx src/cli.ts set-password",
    "set-token": "tsx src/cli.ts set-token",
    "migrate": "tsx src/cli.ts migrate",
    "lint": "eslint .",
    "test": "vitest",
    "test:types": "tsc --noEmit && node scripts/typecheck-uis.mjs",
    "quickcheck": "pnpm run lint && pnpm run test:types",
    "check": "pnpm run quickcheck && vitest run --coverage",
    "prepare": "simple-git-hooks",
    "prepack": "pnpm run build",
    "build:ui": "node scripts/build-uis.mjs stock",
    "build:uis": "node scripts/build-uis.mjs --zip",
    "media": "node scripts/capture-media.mjs"
  },
  "dependencies": {
    "@grammyjs/auto-retry": "^2.0.2",
    "@namesmt/utils": "^0.5.20",
    "@scalar/hono-api-reference": "^0.12.4",
    "@zip.js/zip.js": "^2.17.0",
    "arktype": "^2.2.3",
    "citty": "^0.2.2",
    "consola": "^3.4.2",
    "grammy": "^1.46.0",
    "hono": "^4.13.8",
    "hono-openapi": "^1.3.3",
    "srvx": "^1.0.5",
    "std-env": "^4.2.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@standard-schema/spec": "^1.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.0.1",
    "@vue/test-utils": "^2.5.1",
    "clsx": "^2.1.1",
    "eslint": "^10.11.0",
    "gifenc": "^1.0.3",
    "happy-dom": "^20.14.5",
    "lint-staged": "^17.5.1",
    "lucide-vue-next": "^1.0.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "reka-ui": "^2.10.5",
    "simple-git-hooks": "^2.14.0",
    "splitpanes": "^4.1.2",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.0.1",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "vue-tsc": "^3.3.11"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
